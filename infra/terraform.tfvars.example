# ------------------------------------------------------------------------------
# OCI Authentication
# Generate an API key in the OCI console:
#   Profile → API Keys → Add API Key → download the private key
# The console will show a config snippet with the values below.
# ------------------------------------------------------------------------------

tenancy_ocid     = "ocid1.tenancy.oc1..aaaa..."
user_ocid        = "ocid1.user.oc1..aaaa..."
fingerprint      = "aa:bb:cc:dd:..."
private_key_path = "~/.oci/oci_api_key.pem"

# OCI region — pick the one closest to you, e.g.:
#   eu-paris-1, eu-frankfurt-1, eu-amsterdam-1, us-ashburn-1, us-phoenix-1
region = "eu-paris-1"

# Use tenancy_ocid for the root compartment, or a child compartment OCID
compartment_id = "ocid1.tenancy.oc1..aaaa..."

# Content of your SSH public key (cat ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA..."

# CIDR blocks allowed to reach SSH (port 22). Strongly recommended: restrict to
# your own IP or VPN range instead of the wide-open default. Find your IP with
# `curl -s ifconfig.me`. Leaving this unset defaults to 0.0.0.0/0 (whole internet).
# ssh_ingress_cidrs = ["203.0.113.4/32"]

# ------------------------------------------------------------------------------
# DNS (OCI DNS)
# The chapellu.fr zone is managed by Terraform (created on first apply, or
# imported once if pre-created in the console — see README).
# ------------------------------------------------------------------------------

dns_zone_name = "chapellu.fr"

# Compartment that holds the DNS zone. Leave empty to reuse compartment_id.
# dns_compartment_id = "ocid1.compartment.oc1..aaaa..."

# ------------------------------------------------------------------------------
# Backups (OCI Object Storage)
# Velero writes daily backups to this bucket via the S3-compatible endpoint.
# ------------------------------------------------------------------------------

backup_bucket_name = "cucco-team-backups"
# Bucket lifecycle deletes backup objects older than this many days.
backup_retention_days = 7
