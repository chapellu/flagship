# TEMPLATE — do NOT commit this filled in as plaintext.
#
# 1. Copy to cloud-credentials.enc.yaml
# 2. Paste the values from Terraform:
#      terraform -chdir=infra output -raw velero_s3_access_key_id
#      terraform -chdir=infra output -raw velero_s3_secret_key
# 3. Encrypt in place:
#      sops --encrypt --in-place k8s/backup/cloud-credentials.enc.yaml
# 4. Commit the encrypted file.
apiVersion: v1
kind: Secret
metadata:
  name: velero-cloud-credentials
  namespace: velero
type: Opaque
stringData:
  cloud: |
    [default]
    aws_access_key_id=REPLACE_WITH_velero_s3_access_key_id
    aws_secret_access_key=REPLACE_WITH_velero_s3_secret_key
