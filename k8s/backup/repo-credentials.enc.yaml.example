# TEMPLATE — do NOT commit this filled in as plaintext.
#
# This is the passphrase that encrypts the Kopia backup repository (the
# "Chiffrement côté backup" choice). Velero auto-detects a secret named
# velero-repo-credentials with a repository-password key and uses it for ALL
# backup repositories instead of its built-in static password.
#
# Generate a strong passphrase and STORE IT in your password manager — without
# it, the backups in the bucket cannot be decrypted/restored.
#   openssl rand -base64 32
#
# 1. Copy to repo-credentials.enc.yaml
# 2. Paste your passphrase below
# 3. sops --encrypt --in-place k8s/backup/repo-credentials.enc.yaml
# 4. Commit the encrypted file.
apiVersion: v1
kind: Secret
metadata:
  name: velero-repo-credentials
  namespace: velero
type: Opaque
stringData:
  repository-password: REPLACE_WITH_A_STRONG_PASSPHRASE
